{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jasi-home-deco.vercel.app" }],
      "destination": "https://www.jasihomedeco.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://backend-production-2ce05.up.railway.app/sitemap.xml" },
    { "source": "/productos", "destination": "/_pages/productos.html" },
    { "source": "/sobre-nosotros", "destination": "/_pages/sobre-nosotros.html" },
    { "source": "/contacto", "destination": "/_pages/contacto.html" },
    { "source": "/preguntas-frecuentes", "destination": "/_pages/preguntas-frecuentes.html" },
    { "source": "/productos/:slug", "destination": "/api/render?slug=:slug" },
    { "source": "/carrito", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" },
    { "source": "/:path*", "destination": "/api/render" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
